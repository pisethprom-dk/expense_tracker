# Copy to .env and set real values:  cp .env.example .env
# docker-compose.yml passes this file to both the web and db services.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. The db container creates this database and user the first time
# it starts with an empty volume. Changing them later does not alter an
# existing database.
POSTGRES_DB=expense_tracker_db
POSTGRES_USER=piseth
POSTGRES_PASSWORD=change-me

# Docker: host port for the API. The EC2 server uses 8003 because 8000 is taken.
WEB_PORT=8000
